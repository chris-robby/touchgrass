   "rendered": "trans + crip + tech symposium"
  },
  "content": {
   "rendered": "\n\n\n<h2 id=\"trans-crip-tech-symposium\" class=\"wp-block-heading\">trans + crip + tech symposium</h2>\n\n\n\n<p class=\"wp-block-paragraph\"><strong class=\"myprefix-text-bold\">Monday, November 23, 2026</strong><br>9:00am &#8211; 5:30pm</p>\n\n\n\n<p class=\"wp-block-paragraph\">Fenn Lounge, Teraanga Commons<br>Carleton University</p>\n\n\n\n<p class=\"wp-block-paragraph\">The trans + crip + tech symposium threads together conversations at the intersections of disability studies, transgender studies, and critical studies in technology. This event convenes scholars and activists to think together about trans-crip digital worldmaking, especially in the wake of hostile legislation transnationally.</p>\n\n\n\n<p class=\"wp-block-paragraph\">CART captioning will be provided. Free lunch and refreshments for attendees.</p>\n\n\n\n<p class=\"wp-block-paragraph\"><a href=\"https://carleton.ca/sjc/cu-events/trans-crip-tech-symposium\">View event details and register</a>.</p>\n\n\n\n<figure class=\"wp-block-image size-large\"><img loading=\"lazy\" decoding=\"async\" width=\"1024\" height=\"1365\" src=\"https://events.carleton.ca/wp-content/uploads/2026/10/transcriptech_symposium-1-1024x1365.jpg\" alt=\"The event poster for the trans + crip + tech symposium, featuring headshots of the 6 speakers.\" class=\"wp-image-22086\" srcset=\"https://events.carleton.ca/wp-content/uploads/2026/10/transcriptech_symposium-1-1024x1365.jpg 1024w, https://events.carleton.ca/wp-content/uploads/2026/10/transcriptech_symposium-1-512x683.jpg 512w, https://events.carleton.ca/wp-content/uploads/2026/10/transcriptech_symposium-1-320x427.jpg 320w, https://events.carleton.ca/wp-content/uploads/2026/10/transcriptech_symposium-1-768x1024.jpg 768w, https://events.carleton.ca/wp-content/uploads/2026/10/transcriptech_symposium-1-1152x1536.jpg 1152w, https://events.carleton.ca/wp-content/uploads/2026/10/transcriptech_symposium-1-1536x2048.jpg 1536w, https://events.carleton.ca/wp-content/uploads/2026/10/transcriptech_symposium-1.jpg 1728w\" sizes=\"auto, (max-width: 1024px) 100vw, 1024px\" /></figure>\n",
   "protected": false
  },
